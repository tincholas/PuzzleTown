# Google Analytics 4 Measurement ID (e.g. G-ABC123XYZ)
# To create one: Go to https://analytics.google.com -> Admin -> Data Streams -> Web -> Measurement ID
VITE_GA_MEASUREMENT_ID=

# Optional: Webhook URL (Google Forms, Google Apps Script, Zapier, Cloudflare Worker)
# If provided, every thumbs up/down feedback event will also POST a JSON payload here
VITE_FEEDBACK_WEBHOOK_URL=
